{
  "name": "studyforce",
  "version": "0.1.0",
  "description": "Always-on accountability dashboard for an AI course, German learning and job applications.",
  "main": "electron/main.js",
  "author": "Prathamesh Shimpi",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "test": "node --test test/*.test.js"
  },
  "build": {
    "appId": "app.studyforce",
    "productName": "StudyForce",
    "files": [
      "electron/**",
      "data/**",
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.14.2",
    "wallpaper": "^7.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  }
}
